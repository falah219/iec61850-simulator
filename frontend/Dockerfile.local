# Frontend simulator (pola sama dengan acuan iec104_rtu_simulator): build Vite lalu `vite preview`.
FROM node:22

WORKDIR /srv/frontend
COPY package*.json ./
RUN npm ci

COPY . .
# Alamat backend ditanam saat build (Vite). Kosong = http://<host halaman>:6061
ARG VITE_BACKEND_URL=
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
RUN npm run build

EXPOSE 4061
CMD ["npm", "run", "preview", "--", "--host", "--port", "4061"]
