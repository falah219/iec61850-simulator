# Contoh konfigurasi lokal. Salin ke backend/.env (TIDAK di-commit) kalau mau mengubah nilai.
# Port HTTP API + Socket.IO
HTTP_PORT=6061
# Level log: error, warn, info, debug, trace
RUST_LOG=info
# Tulis log juga ke file harian logs/simulator.YYYY-MM-DD (matikan di Kubernetes)
LOG_TO_FILE=true
# Jumlah file log harian yang disimpan (0 = tanpa batas)
LOG_MAX_FILES=14
# Jumlah IED contoh saat start: SIMIED1..SIMIED<N> (template komponen sama)
IED_COUNT=1
# Prefix nama IED: <IED_PREFIX><n>, domain MMS = nama IED + LD_NAME (mis. SIMIED1LD0)
IED_PREFIX=SIMIED
# Nama LD. Huruf/angka/_, diawali huruf, nama IED + LD maks 32 karakter
LD_NAME=LD0
# Port MMS: IED ke-1 = MMS_PORT, IED ke-n (n >= 2) = MMS_PORT_BASE + n - 2 (10102, 10103, ...).
# Di docker compose keduanya diatur di docker-compose.yml (harus cocok dengan port yang di-publish)
MMS_PORT=102
MMS_PORT_BASE=10102
