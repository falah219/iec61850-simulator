# Contoh konfigurasi lokal. Salin ke backend/.env (TIDAK di-commit) kalau mau mengubah nilai.
# Port HTTP API + Socket.IO
HTTP_PORT=6061
# Level log: error, warn, info, debug, trace
RUST_LOG=info
# Tulis log juga ke file harian logs/simulator.YYYY-MM-DD (matikan di Kubernetes)
LOG_TO_FILE=true
# Jumlah file log harian yang disimpan (0 = tanpa batas)
LOG_MAX_FILES=14
# Nama IED (domain MMS = <IED_NAME>LD0, mis. SIMIED1LD0)
IED_NAME=SIMIED1
# Port MMS IED
MMS_PORT=102
# Nama LD (domain MMS = IED_NAME + LD_NAME). Huruf/angka/_, diawali huruf, total maks 32 karakter
LD_NAME=LD0
