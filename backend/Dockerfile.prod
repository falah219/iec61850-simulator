# syntax=docker/dockerfile:1
# Backend simulator untuk server / Kubernetes (dibuild install.sh). Beda dengan Dockerfile.local:
# tanpa cache mount (build bersih & bisa diulang), binary di-strip, tanpa curl (probe Kubernetes httpGet).

FROM rust:slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*

# libIEC61850 v1.6.2.1 dari source di repo + patch simulator (lihat THIRD_PARTY_NOTICES.md)
COPY native/libiec61850 /tmp/libiec61850
RUN cmake -S /tmp/libiec61850 -B /tmp/libiec61850/build -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/libiec61850/build -j"$(nproc)" \
    && cmake --install /tmp/libiec61850/build \
    && rm -rf /tmp/libiec61850

WORKDIR /srv/backend
COPY Cargo.toml Cargo.lock build.rs wrapper.h ./
COPY src ./src
RUN cargo build --release --locked && strip target/release/iec61850-simulator

FROM debian:bookworm-slim

# uid/gid 999 tetap: dipakai fsGroup di backend/k8s/deployment.yaml
RUN groupadd -r -g 999 appuser && useradd -r -u 999 -g appuser -d /app appuser \
    && mkdir -p /app /data && chown appuser:appuser /app /data

WORKDIR /app
COPY --from=builder /srv/backend/target/release/iec61850-simulator /app/
USER appuser

# HTTP API + Socket.IO; port MMS diatur env (MMS_PORT, MMS_PORT_BASE), autosave di /data (volume)
EXPOSE 6061
ENV LOG_TO_FILE=false
CMD ["./iec61850-simulator"]
